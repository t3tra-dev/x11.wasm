ninja_required_version = 1.5

builddir = build/emscripten

x11wasm_root = .
x11wasm_builddir = $builddir
x11wasm_emcache = $builddir/em-cache

include ninja/x11wasm.ninja

x11wasm_browser_dist = build/browser
x11wasm_browser_main = $builddir/browser-main.o
x11wasm_browser_manager_focus = $builddir/browser-manager-focus.o
x11wasm_browser_geometry = $builddir/browser-geometry.o
x11wasm_browser_manager = $builddir/browser-manager.o
x11wasm_browser_app = $x11wasm_browser_dist/x11.html

rule x11wasm_typecheck_js
  command = mkdir -p build && tsc -p tsconfig.json && touch build/typecheck-js.stamp
  description = typecheck x11.wasm browser JS

rule x11wasm_compile_commands
  command = python3 tools/gen_compile_commands.py --output build/compile_commands.json
  description = generate x11.wasm compile_commands.json

rule x11wasm_link_browser
  command = root=$$(pwd) && emcache="$x11wasm_emcache" && case "$$emcache" in /*) ;; *) emcache="$$root/$$emcache";; esac && mkdir -p "$$root/$x11wasm_browser_dist" "$$emcache" && EM_CACHE="$$emcache" emcc "$$root/$x11wasm_browser_main" "$$root/$x11wasm_browser_geometry" "$$root/$x11wasm_browser_manager" "$$root/$x11wasm_browser_manager_focus" "$$root/$x11wasm_lib" --js-library "$$root/$x11wasm_js_library" --pre-js "$$root/$x11wasm_js_pre" --shell-file "$$root/test/browser/shell.html" -sALLOW_MEMORY_GROWTH=1 -sEXIT_RUNTIME=0 -sERROR_ON_UNDEFINED_SYMBOLS=1 -sEXPORTED_FUNCTIONS=_main,_malloc,_free -o "$$root/$x11wasm_browser_app"
  description = link x11.wasm browser harness

build build/typecheck-js.stamp: x11wasm_typecheck_js $
  tsconfig.json $
  $x11wasm_js_types $
  $x11wasm_js_library_bridge $
  $x11wasm_js_library_window $
  $x11wasm_js_library_draw $
  $x11wasm_js_library_runtime $
  $x11wasm_js_library_wm $
  $x11wasm_js_dom_private $
  $x11wasm_js_dom_types $
  $x11wasm_js_dom_constants $
  $x11wasm_js_dom_helpers $
  $x11wasm_js_dom_backend_core $
  $x11wasm_js_dom_backend_window $
  $x11wasm_js_dom_backend_runtime $
  $x11wasm_js_dom_backend_draw $
  $x11wasm_js_dom_backend_wm $
  $x11wasm_js_dom_backend_input $
  $x11wasm_js_dom_backend_render $
  $x11wasm_js_dom_manager_icons $
  $x11wasm_js_dom_manager_gestures $
  $x11wasm_js_dom_manager_states $
  $x11wasm_js_dom_backend_manager $
  $x11wasm_js_dom_backend_export $
  tests/types/playwright-node.d.ts $
  tests/support/x11.js $
  tests/support/chrome-stdio.js $
  tests/x11/bridge.spec.js $
  tests/x11/lifecycle.spec.js $
  tests/x11/manager-focus.spec.js $
  tests/x11/rendering.spec.js $
  tests/x11/runtime.spec.js $
  tests/x11/selection.spec.js $
  tests/x11/clipboard-lifecycle.spec.js $
  tests/x11/server.spec.js $
  tests/x11/wm.spec.js $
  tests/x11/fullscreen-lifecycle.spec.js $
  tests/x11/manager.spec.js $
  tests/x11/manager-contract.spec.js $
  tests/x11/manager-actions.spec.js $
  tests/x11/geometry.spec.js $
  tests/x11/wm-state.spec.js $
  tests/x11/zero-width.spec.js $
  tests/x11/text-boundaries.spec.js $
  tests/x11/manager-native.spec.js $
  tests/x11/manager-state.spec.js $
  playwright.config.js
build build/compile_commands.json: x11wasm_compile_commands tools/gen_compile_commands.py build.ninja ninja/x11wasm.ninja
build $x11wasm_browser_main: x11wasm_compile_c test/browser/main.c | $x11wasm_xlib_common_deps
build $x11wasm_browser_manager_focus: x11wasm_compile_c test/browser/manager-focus.c | $x11wasm_xlib_common_deps
build $x11wasm_browser_geometry: x11wasm_compile_c test/browser/geometry.c | $x11wasm_xlib_common_deps
build $x11wasm_browser_manager: x11wasm_compile_c test/browser/manager.c | $x11wasm_xlib_common_deps
build $x11wasm_browser_app: x11wasm_link_browser $x11wasm_browser_main $x11wasm_browser_geometry $x11wasm_browser_manager $x11wasm_browser_manager_focus $x11wasm_lib build/typecheck-js.stamp $x11wasm_js_library $x11wasm_js_pre test/browser/shell.html | x11wasm_header_tests
build $builddir/zero-width.o: x11wasm_compile_c test/browser/zero-width.c | $x11wasm_xlib_common_deps
build $x11wasm_browser_dist/zero-width.html: x11wasm_link_browser $builddir/zero-width.o $x11wasm_browser_geometry $x11wasm_browser_manager $x11wasm_browser_manager_focus $x11wasm_lib build/typecheck-js.stamp $x11wasm_js_library $x11wasm_js_pre test/browser/shell.html | x11wasm_header_tests
  x11wasm_browser_main = $builddir/zero-width.o
  x11wasm_browser_app = $x11wasm_browser_dist/zero-width.html
build $x11wasm_browser_dist/LICENSE $
  $x11wasm_browser_dist/THIRD_PARTY_NOTICES.md $
  $x11wasm_browser_dist/LICENSES/X11.txt $
  $x11wasm_browser_dist/LICENSES/Tk.txt $
  $x11wasm_browser_dist/LICENSES/Lucide.txt: x11wasm_stage_licenses $
  $x11wasm_root/LICENSE $
  $x11wasm_root/THIRD_PARTY_NOTICES.md $
  $x11wasm_root/LICENSES/X11.txt $
  $x11wasm_root/LICENSES/Tk.txt $
  $x11wasm_root/LICENSES/Lucide.txt
  x11wasm_license_dest = $x11wasm_browser_dist

build typecheck_js: phony build/typecheck-js.stamp
build compile_commands: phony build/compile_commands.json
build browser_licenses: phony $x11wasm_browser_dist/LICENSE
build browser: phony $x11wasm_browser_app $x11wasm_browser_dist/zero-width.html x11wasm_header_tests browser_licenses

default x11wasm
