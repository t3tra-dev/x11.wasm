{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true
  },
  "include": [
    "js/**/*.js",
    "js/**/*.d.ts",
    "tests/**/*.js",
    "tests/**/*.d.ts",
    "playwright.config.js"
  ]
}
